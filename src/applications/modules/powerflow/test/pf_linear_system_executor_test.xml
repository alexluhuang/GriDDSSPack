<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <Powerflow>
    <networkConfiguration>IEEE14.raw</networkConfiguration>
    <maxIteration>50</maxIteration>
    <tolerance>1.0e-6</tolerance>
    <qlim>false</qlim>
    <SwitchedShunt>false</SwitchedShunt>
    <LTC>false</LTC>
    <AreaInterchange>false</AreaInterchange>

    <!-- This must never be configured while an executor handles the solve. -->
    <LinearSolver>
      <Backend>invalid_backend_for_lazy_executor_test</Backend>
      <PETScOptions>
        -ksp_type preonly
        -pc_type lu
        -pc_factor_mat_solver_type klu
      </PETScOptions>
    </LinearSolver>

    <Executor>
      <LinearSolver>
        <Backend>petsc</Backend>
        <PETScOptions>
          -ksp_type preonly
          -pc_type lu
          -pc_factor_mat_solver_type klu
        </PETScOptions>
      </LinearSolver>
    </Executor>
  </Powerflow>
</Configuration>
