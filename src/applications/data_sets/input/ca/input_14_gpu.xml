<?xml version="1.0" encoding="utf-8"?>
<!--
  IEEE 14-bus N-1 contingency analysis with the NVIDIA cuDSS GPU direct-LU
  backend enabled.  Identical to input_14.xml except the linear solve runs on
  the GPU (Backend=cudss, GPU/enabled=true).  Requires a build with
  GRIDPACK_WITH_CUDSS=ON and a visible CUDA device; otherwise CA silently falls
  back to the CPU PETSc path and the results are unchanged.

  Invocation is identical to the CPU case:
      mpirun -n 1 ca.x input_14_gpu.xml

  The three output CSVs (_delta/_flat, _buses, _convergence) are byte-for-byte
  the same as the CPU run (to FP64 round-off, after the documented event_idx
  sort).  See GPU_CA_IMPLEMENTATION.md for validation against golden files.
-->
<Configuration>
  <Contingency_analysis>
    <printCalcFiles>false</printCalcFiles>
    <FullBranchN1>true</FullBranchN1>
    <FullGeneratorN1>true</FullGeneratorN1>
    <groupSize>1</groupSize>
    <maxVoltage>1.1</maxVoltage>
    <minVoltage>0.9</minVoltage>
    <qlim>true</qlim>
    <outputFormat>csv_delta</outputFormat>
    <outputFile>ca_IEEE14_gpu</outputFile>
    <GPU>
      <enabled>true</enabled>        <!-- master opt-in switch -->
      <batched>false</batched>       <!-- Phase 1 per-contingency drop-in solve -->
      <waveSize>auto</waveSize>
      <screen>true</screen>
      <fastDecoupled>false</fastDecoupled>
      <!-- cuDSS numerical tunables (iterativeRefinement, deterministic,
           hybridMemory) are read from <Powerflow><LinearSolver> below, not here. -->
    </GPU>
  </Contingency_analysis>
  <Powerflow>
    <networkConfiguration>IEEE14_ca.raw</networkConfiguration>
    <maxIteration>50</maxIteration>
    <tolerance>1.0e-6</tolerance>
    <qlim>true</qlim>
    <LinearSolver>
      <!-- Route the Newton-Raphson linear solve through cuDSS. When the GPU
           is unavailable the code falls back to the PETScOptions path below. -->
      <Backend>cudss</Backend>
      <!-- cuDSS tunables (all optional):
           iterativeRefinement: gate mixed-precision IR behind a residual check
           deterministic:       reproducible (bit-wise) factorization, slower
           hybridMemory:        use host/unified pointers (Grace-Blackwell) -->
      <iterativeRefinement>false</iterativeRefinement>
      <deterministic>false</deterministic>
      <hybridMemory>false</hybridMemory>
      <!-- Fallback CPU direct-LU options (used when cuDSS is unavailable).
           The solver package token below is substituted at build time with the
           LU package the local PETSc was built with (superlu_dist/mumps/klu). -->
      <PETScPrefix>pre_</PETScPrefix>
      <PETScOptions>
        -ksp_type preonly
        -pc_type lu
        -pc_factor_mat_solver_type superlu_dist
      </PETScOptions>
    </LinearSolver>
  </Powerflow>
</Configuration>
